file(MAKE_DIRECTORY "${WORK}")
foreach(stage vertex pixel)
    if(stage STREQUAL "vertex")
        set(fixture pgr4_duplicate_fetch.vert.bin)
    else()
        set(fixture F7DDC03EFA734623.bin)
    endif()
    execute_process(COMMAND "${XENOS_RECOMP}" "${FIXTURE_DIR}/${fixture}" "${WORK}/${stage}.hlsl" "${SHADER_COMMON}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Failed translating ${stage} fixture")
    endif()
endforeach()
# This guest shader fetches POSITION1..3 twice using different indices.
# Deduplicate the IA inputs, while retaining both guest fetch addresses.
file(READ "${WORK}/vertex.hlsl" vertex)
foreach(row RANGE 1 3)
    math(EXPR metadata "${row} - 1")
    foreach(index w z)
        string(FIND "${vertex}" "loadIndexedPosition(g_IndexedPosition${row}, g_IndexedPosition(${metadata}u), trunc(r0.${index}))" fetch)
        if(fetch EQUAL -1)
            message(FATAL_ERROR "Duplicate POSITION${row} fetch by r0.${index} was lost")
        endif()
    endforeach()
endforeach()
execute_process(COMMAND "${REFLECT}" "${WORK}/vertex.hlsl" "${WORK}/pixel.hlsl" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "DXBC reflection regression failed")
endif()
