file(GLOB prior_fixtures "${WORK}/input/*.bin")
if(prior_fixtures)
    file(REMOVE ${prior_fixtures})
endif()
file(MAKE_DIRECTORY "${WORK}/input")
file(COPY "${FIXTURE_DIR}/F7DDC03EFA734623.bin" "${FIXTURE_DIR}/pgr4_duplicate_fetch.vert.bin" "${FIXTURE_DIR}/pgr4_sampler_alias.vert.bin" DESTINATION "${WORK}/input")
execute_process(COMMAND "${XENOS_RECOMP}" "${WORK}/input" "${WORK}/cache.cpp" "${SHADER_COMMON}" --jobs 1
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Shader cache compilation failed (${result}):\n${stdout}\n${stderr}")
endif()
file(READ "${WORK}/cache.cpp" cache)
foreach(symbol g_compressedDxbcCache g_dxbcCacheCompressedSize g_dxbcCacheDecompressedSize)
    if(NOT cache MATCHES "${symbol}")
        message(FATAL_ERROR "Compiled cache has no ${symbol}")
    endif()
endforeach()
if(NOT cache MATCHES "g_shaderCacheEntryCount = 3;")
    message(FATAL_ERROR "DXBC compile dropped a shader: ${stdout}\n${stderr}")
endif()
string(REGEX MATCHALL "\\{ 0x[0-9A-F]+, [0-9]+, [0-9]+, [0-9]+, [0-9]+, [0-9]+, [0-9]+, [0-9]+, \"[^\"]+\", [0-9]+, [1-9][0-9]* \\}" entries "${cache}")
list(LENGTH entries count)
if(NOT count EQUAL 3)
    message(FATAL_ERROR "Expected nonempty trailing DXBC ranges for all three shaders")
endif()

# An enabled backend failing must leave the prior complete cache untouched.
file(READ "${SHADER_COMMON}" common)
file(WRITE "${WORK}/invalid_common.h" "${common}\n#ifdef __DXBC__\n#error intentional_DXBC_failure\n#endif\n")
file(WRITE "${WORK}/preserved.cpp" "previous-cache\n")
execute_process(COMMAND "${XENOS_RECOMP}" "${WORK}/input" "${WORK}/preserved.cpp" "${WORK}/invalid_common.h" --jobs 1
    RESULT_VARIABLE failure OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(failure EQUAL 0 OR NOT stderr MATCHES "DXBC compilation failed")
    message(FATAL_ERROR "DXBC compiler failure was not reported: ${stdout}\n${stderr}")
endif()
file(READ "${WORK}/preserved.cpp" preserved)
if(NOT preserved STREQUAL "previous-cache\n")
    message(FATAL_ERROR "DXBC failure replaced the previous usable cache")
endif()
