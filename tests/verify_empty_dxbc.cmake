file(MAKE_DIRECTORY "${WORK}/input")
file(COPY "${FIXTURE_DIR}/fm2_ieee_sqrt.vert.bin" DESTINATION "${WORK}/input")
execute_process(COMMAND "${XENOS_RECOMP}" "${WORK}/input" "${WORK}/cache.cpp" "${SHADER_COMMON}" --jobs 1
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Disabled-DXBC cache generation failed: ${stdout}\n${stderr}")
endif()
file(READ "${WORK}/cache.cpp" cache)
foreach(symbol g_compressedDxbcCache g_dxbcCacheCompressedSize)
    if(NOT cache MATCHES "${symbol}")
        message(FATAL_ERROR "Disabled-DXBC cache has no ${symbol}")
    endif()
endforeach()
if(NOT cache MATCHES "g_dxbcCacheDecompressedSize = 0;")
    message(FATAL_ERROR "Disabled-DXBC cache is not empty")
endif()
if(NOT cache MATCHES "\", 0, 0 \\}")
    message(FATAL_ERROR "Disabled-DXBC cache does not have empty trailing ranges")
endif()
